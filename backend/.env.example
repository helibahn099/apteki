# Конфигурация бэкенда Savvy Meds (скопируйте в .env). Секреты не коммитить!
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/savvy_meds
RUN_MIGRATIONS=true
SEED_DEV_DATA=true
LOG_LEVEL=info
LOG_FORMAT=json
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
ADMIN_PHONES=
# Telegram (зарезервировано; в тестовом режиме все OTP уходят в TELEGRAM_TEST_CHAT_ID)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ENABLED=false
TELEGRAM_TEST_CHAT_ID=
# Gemini Flash (зарезервировано)
GEMINI_API_KEY=
# Поиск
SEARCH_MIN_RADIUS_METERS=100
SEARCH_MAX_RADIUS_BASIC_METERS=4000
SEARCH_RADIUS_STEP_METERS=500
SEARCH_MAX_RESULTS=15
SEARCH_HARD_MIN_RESULTS=1
SEARCH_SOFT_MIN_RESULTS=3
# PHARMACY_REQUEST_INTERVAL_SECS — будет уменьшаться по мере стабилизации системы
PHARMACY_REQUEST_INTERVAL_SECS=60
MOCK_PAYMENT_ENABLED=true
MOCK_PAYMENT_WEBHOOK_SECRET=change-me-mock-webhook-secret
SUPPORT_TELEGRAM=@helibahn
CORS_ALLOWED_ORIGINS=http://localhost:3000
